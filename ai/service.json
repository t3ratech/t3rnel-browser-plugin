{
  "name": "T3rnel Browser",
  "type": "browser extension + local MCP session bridge",
  "interfaces": [
    {
      "kind": "mcp",
      "transport": "stdio",
      "install": "npx -y @t3ratech/mcp-session-bridge",
      "tools": 97
    },
    {
      "kind": "markdown",
      "url": "https://browser.t3ratech.co.zw/llms.txt"
    }
  ],
  "approvalGate": {
    "default": "off",
    "modes": [
      "off",
      "high",
      "all"
    ],
    "risk": {
      "low": 65,
      "medium": 16,
      "high": 14,
      "conditional": 2
    }
  },
  "privacy": "never sends browsing data; local-only storage; an account and anonymous usage events"
}
